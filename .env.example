# Copy this file to .env and fill in your real key:
#   cp .env.example .env
#
# .env is loaded automatically by `docker compose` and is git-ignored, so
# your key never gets committed. docker-compose.yml only references
# ${GEMINI_API_KEY} — it never contains the secret itself, which is what
# makes it safe to commit compose files to a public portfolio repo.

GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-2.5-flash
